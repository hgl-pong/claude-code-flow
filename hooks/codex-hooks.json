{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/scripts/ulw-detector.py",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/scripts/uli-detector.py",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/scripts/plan-detector.py",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/scripts/keyword-router.py",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|shell_command|functions.shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/scripts/pre-commit-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|spawn_agent|send_input|wait_agent",
        "hooks": [
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/scripts/pre-agent-guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/scripts/memory-inject.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/scripts/session-check.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/scripts/flow-state.py snapshot",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/scripts/gitnexus-check.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|apply_patch|functions.apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/scripts/track-changes.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/scripts/comment-checker.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|shell_command|functions.shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/scripts/track-verification.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/scripts/todo-enforcer.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/scripts/ulw-stop-hook.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/scripts/uli-stop-hook.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/scripts/on-workflow-stop.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/scripts/gitnexus-update.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
