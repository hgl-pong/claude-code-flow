{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/auto-mode/auto-mode-hooks.py session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/auto-mode/auto-mode-hooks.py stop"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "general-purpose|Explore|Plan",
        "hooks": [
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/auto-mode/auto-mode-hooks.py subagent-start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "general-purpose|Explore|Plan",
        "hooks": [
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/auto-mode/auto-mode-hooks.py subagent-stop"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/auto-mode/auto-mode-hooks.py pre-compact"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/auto-mode/auto-mode-hooks.py teammate-idle"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "WebSearch|WebFetch|mcp__web-search-prime__web_search_prime|mcp__web-reader__webReader|mcp__web_reader__webReader",
        "hooks": [
          {
            "type": "command",
            "command": "python ${PLUGIN_ROOT}/hooks/scripts/9router-intercept.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
